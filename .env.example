# Copy to .env (never commit .env)
SAFELOOP_API_TOKEN=change-me-long-random-string
GRAFANA_ADMIN_PASSWORD=change-me
DOCKER_GID=999                       # `getent group docker | cut -d: -f3`
SAFELOOP_OLLAMA_URL=http://host.docker.internal:11434
SAFELOOP_OLLAMA_MODEL=qwen3:8b
# SAFELOOP_LITELLM_MODEL=             # optional; needs `pip install litellm` + provider API key
# SAFELOOP_ALLOW_DEV_SCRIPTED=0       # keep 0 outside tests
SAFELOOP_RATE_LIMIT_PER_MIN=60     # per client; 0 disables
SAFELOOP_RETENTION_DAYS=30           # purge tasks older than N days; 0 disables
# SAFELOOP_OTLP_ENDPOINT=http://localhost:4318/v1/traces   # optional tracing
