{
 "uid": "sl-economics",
 "title": "Model Economics",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "tags": [
  "safeloop"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Tokens by type (where reported)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model, type) (increase(safeloop_tokens_total[$__rate_interval]))",
     "legendFormat": "{{model}} {{type}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "No data"
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Model call latency p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, model) (rate(safeloop_model_call_duration_seconds_bucket[$__rate_interval])))",
     "legendFormat": "{{model}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "noValue": "No data"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Cost by source (reported vs estimated)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (source) (increase(safeloop_model_cost_usd_total[$__rate_interval]))",
     "legendFormat": "{{source}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "noValue": "No data"
    },
    "overrides": []
   },
   "description": "Only calls with a known cost contribute. Local models (Ollama) report no cost."
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Cost per finished task (known cost only)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(safeloop_model_cost_usd_total[1h])) / clamp_min(sum(increase(safeloop_tasks_total[1h])), 1)",
     "legendFormat": "$/task",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "noValue": "No data"
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Cost per successful task (known cost only)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 8,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(safeloop_model_cost_usd_total[1h])) / clamp_min(sum(increase(safeloop_tasks_total{status=\"SUCCESS\"}[1h])), 1)",
     "legendFormat": "$/success",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "noValue": "No data"
    },
    "overrides": []
   }
  }
 ]
}